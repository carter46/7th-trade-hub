# Demo OR owned-tool credentials from Hub (never mix both on one site)
SEVENTH_TRADEHUB_INTEGRATION_ID=
SEVENTH_TRADEHUB_CLIENT_ID=
SEVENTH_TRADEHUB_CLIENT_SECRET=
SEVENTH_TRADEHUB_WEBHOOK_SECRET=

# Hub webhook (owned admin credential sync + optional ping):
# {SEVENTH_TRADEHUB_HUB_URL}/webhooks/site-integrations/{SEVENTH_TRADEHUB_INTEGRATION_ID}

# Hub base URL — include https://, no trailing slash
# Example: https://7th-tradehub.online
SEVENTH_TRADEHUB_HUB_URL=https://your-hub.example
